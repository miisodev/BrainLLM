# BrainLLM MCP — environment variables
# Copy this file to .env and fill in your values.

# URL of your TriliumNext instance
# Local desktop (default):
TRILIUM_BASE_URL=http://localhost:8080
# Remote / cloud (VPS or reverse proxy):
# TRILIUM_BASE_URL=https://trilium.yourdomain.com

# ETAPI token — create in Trilium (Options → ETAPI → Create token), or set
# TRILIUM_PASSWORD instead and `bun run init` will mint one for you and print it.
TRILIUM_ETAPI_TOKEN=

# Alternative to the token: when TRILIUM_ETAPI_TOKEN is empty, BrainLLM mints one on
# first start and caches it beside brainllm.json, reusing it across restarts.
# Also used by `bun run init`.
TRILIUM_PASSWORD=

# ── Tool surface ───────────────────────────────────────────────────────────────
# core (default): the 38 brain-aware tools. full: adds the 33 raw ETAPI tools.
# BRAINLLM_MODE=full

# ── Timezone ───────────────────────────────────────────────────────────────────
# IANA timezone for date stamping on hosted deploys (e.g. Africa/Johannesburg).
# Leave unset to use the host clock — correct when BrainLLM runs on your machine.
# BRAINLLM_TZ=

# ── HTTP connector mode (Railway / remote) ────────────────────────────────────
# When PORT is set the server starts an HTTP/SSE connector instead of stdio.
# Railway sets PORT automatically; do NOT set it for local Claude Code usage.
# PORT=8080

# Bearer token that all MCP clients must send as Authorization: Bearer <token>.
# Generate with: openssl rand -hex 32
# MCP_AUTH_TOKEN=

# ── Config persistence (Railway / persistent-volume deploys) ──────────────────
# Absolute path where brainllm.json should be read/written.
# Set this to a mounted volume path so config survives container redeploys.
# Leave unset for local/stdio use — defaults to the directory next to the bundle.
# BRAINLLM_CONFIG=/data/brainllm.json

# ── OAuth (hosted Claude surfaces) ─────────────────────────────────────────────
# Setting this turns on the OAuth 2.1 / CIMD endpoints, which is the ONLY way
# claude.ai, Claude mobile and Cowork can connect — their custom-connector UI
# offers OAuth or nothing, with no field for a bearer token. It is the password
# you type on the consent screen when authorizing a client. Leave unset and the
# OAuth surface is disabled entirely; MCP_AUTH_TOKEN still works for Claude Code.
# BRAINLLM_OWNER_PASSWORD=

# Only needed if a proxy rewrites Host so the server cannot derive its own
# public URL. Must match the URL you type into the client, exactly.
# BRAINLLM_PUBLIC_URL=https://brainllm.example.com

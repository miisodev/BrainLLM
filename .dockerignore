.github
.claude
node_modules
dist
coverage
*.log
.env
.env.*
brainllm.json
*.oauth.json
*.token
src/brainllm.oauth.json
CLAUDE.md
AGENTS.md
GEMINI.md
docs
Context
scripts/*.ts
scripts/*.spec.ts
